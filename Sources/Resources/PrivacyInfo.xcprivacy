<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 이 바이너리(앱 코드)가 추적을 하는지. 하지 않는다 — 앱이 부르는 서버는
	     ai.zerolive.co.kr 하나뿐이고 거기 보내는 값은 광고에 쓰이지 않는다.
	     AdMob 이 광고 식별자로 하는 일은 GoogleMobileAds.framework 가 자기
	     매니페스트로 따로 신고한다. 매니페스트는 바이너리마다 자기 동작만 적는다.

	     true 로 두려면 NSPrivacyTrackingDomains 에 도메인을 하나 이상 적어야 한다.
	     빈 배열이면 업로드가 ITMS-91064 로 거부된다. 그리고 여기 적은 도메인은
	     추적 허가를 받지 못한 사용자에게 iOS 가 연결을 끊는다 — AdMob 도메인을
	     적으면 허가를 거부한 사용자에게 광고가 아예 안 나간다.

	     App Store Connect 의 '앱 개인정보' 설문은 이것과 별개다. 그쪽은 SDK 가
	     가져가는 것까지 합쳐 사람이 신고하는 자리라 추적 '예' 가 맞다. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- 앱이 서버로 보내는 것만 적는다. 청취 기록·즐겨찾기·프리셋·이어듣기 위치는
	     SwiftData 로 기기에만 남고 서버에 가지 않으므로 적지 않는다.
	     AdMob 이 수집하는 항목은 SDK 자기 매니페스트가 따로 신고한다. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- 설치 UUID. 알람 등록과 히든 해제, 남용 차단에 쓴다. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- APNs 기기 토큰. 알람 푸시를 보내는 데만 쓴다. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- 재생에 실패한 방송국 번호. 죽은 방송국을 목록에서 빼는 데 쓴다. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- 사유를 밝혀야 하는 API. @AppStorage(테마·타이머 기본값)와 재생 속도 기억에
	     UserDefaults 를 쓴다. CA92.1 = 이 앱이 저장한 값을 이 앱이 읽는 경우. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
