<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AdMob 이 개인화 광고를 위해 광고 식별자를 쓴다. 그래서 추적에 해당한다.
	     추적 도메인은 GoogleMobileAds.framework 가 자기 매니페스트에 이미 적어 둔다. -->
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- 앱이 서버로 보내는 것만 적는다. 청취 기록·즐겨찾기·프리셋·이어듣기 위치는
	     SwiftData 로 기기에만 남고 서버에 가지 않으므로 적지 않는다.
	     AdMob 이 수집하는 항목은 SDK 자기 매니페스트가 따로 신고한다. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- 설치 UUID. 알람 등록과 히든 해제, 남용 차단에 쓴다. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- APNs 기기 토큰. 알람 푸시를 보내는 데만 쓴다. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- 재생에 실패한 방송국 번호. 죽은 방송국을 목록에서 빼는 데 쓴다. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- 사유를 밝혀야 하는 API. @AppStorage(테마·타이머 기본값)와 재생 속도 기억에
	     UserDefaults 를 쓴다. CA92.1 = 이 앱이 저장한 값을 이 앱이 읽는 경우. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
