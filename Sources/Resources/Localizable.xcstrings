            "value" : "Mon"
          }
        }
      }
    },
    "윌리엄 텔" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "William Tell"
          }
        }
      }
    },
    "유튜브 재생목록은 더 쓸 수 없습니다" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube playlists are no longer available"
          }
        }
      }
    },
    "유튜브는 화면을 끈 채 소리만 재생하는 것을 약관에서 막고 있습니다. 이 앱은 취침·운전처럼 화면을 보지 않는 상황에 쓰는 앱이라, 약관을 지키면서 그 기능을 유지할 방법이 없었습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube's terms do not allow playing only the audio with the screen off. This app is for moments when you are not looking at the screen — falling asleep, driving — so keeping that feature would have meant breaking those terms."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유튜브는 화면을 끈 채 소리만 재생하는 것을 약관에서 막고 있습니다. 이 앱은 취침·운전처럼 화면을 보지 않는 상황에 쓰는 앱이라, 약관을 지키면서 그 기능을 유지할 방법이 없었습니다."
          }
        }
      }
    },
    "이 기기는 Apple Intelligence 를 지원하지 않습니다. 추천은 그대로 나옵니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device does not support Apple Intelligence. Recommendations still work."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 Apple Intelligence 를 지원하지 않습니다. 추천은 그대로 나옵니다."
          }
        }
      }
    },
    "이 달에는 기록이 없습니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing was played this month."
          }
        }
      }
    },
    "이 달에는 들은 기록이 없습니다. 프리셋이나 탐색 탭에서 방송을 켜면 여기에 쌓입니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing was played this month. Start a station from Presets or Browse and it shows up here."
          }
        }
