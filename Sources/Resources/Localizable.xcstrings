    },
    "운전" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Driving"
          }
        }
      }
    },
    "울릴 때 그 시각에 맞는 방송을 서버가 골라 알려 줍니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When it rings, the server picks a station that fits that hour."
          }
